# Example environment configuration
# Copy this file to .env.development, .env.staging, or .env.production
# and update the values for your environment

# Core remote app URL
VITE_CORE_REMOTE_ENTRY_URL=http://localhost:3002/remoteEntry.js

# Campaigns remote app URL
VITE_CAMPAIGNS_REMOTE_ENTRY_URL=http://localhost:3003/remoteEntry.js

# Analytics service configuration
# Service URL for the analytics-service Azure Function
VITE_ANALYTICS_SERVICE_URL=https://analytics-service-func-dev.azurewebsites.net
# Write key - should be retrieved from Azure Key Vault in deployment
# For local dev, get the key from Key Vault manually
VITE_ANALYTICS_WRITE_KEY=get-from-keyvault
