# Development environment configuration
# These values are used when running `npm run dev`

# Core remote app URL (Azure dev environment)
VITE_CORE_REMOTE_ENTRY_URL=https://react-app-core-dev.reddune-3f892dde.northeurope.azurecontainerapps.io/assets/remoteEntry.js

# Campaigns remote app URL (local development - stub used as fallback)
VITE_CAMPAIGNS_REMOTE_ENTRY_URL=http://localhost:3003/remoteEntry.js

# Analytics service configuration
# Azure Function endpoint for analytics-service
VITE_ANALYTICS_SERVICE_URL=https://analytics-service-func-dev.azurewebsites.net
# Write key - retrieve from Azure Key Vault
# az keyvault secret show --name analytics-write-key --vault-name <your-keyvault-name> --query value -o tsv
VITE_ANALYTICS_WRITE_KEY=get-from-keyvault
